# Copy this file to .env and fill in your values. Never commit .env.

# Free key: https://api.open.fec.gov/developers/  (DEMO_KEY works but is heavily rate limited)
FEC_API_KEY=DEMO_KEY

# Local development
DEBUG=True
SECRET_KEY=local-dev-secret-change-me

# Leave DATABASE_URL commented out to use SQLite locally.
# For PostgreSQL: postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=
